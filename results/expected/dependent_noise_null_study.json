      "hypotheses": [
        {
          "id": "H1",
          "statement": "The circular-shift null is controlled on every stationary process, including fractional Gaussian noise at H = 0.95 and GARCH(1,1) noise."
        },
        {
          "id": "H2",
          "statement": "The phase-randomization null is controlled on every stationary Gaussian process, which is fractional Gaussian noise at every H."
        },
        {
          "id": "H3",
          "statement": "The permutation null is inflated on every long-memory process, which is fractional Gaussian noise with H > 0.5."
        },
        {
          "id": "H4",
          "statement": "The circular-shift null is inflated on the random walk, because its stationarity assumption fails there."
        },
        {
          "id": "H5",
          "statement": "The phase-randomization null is inflated on the random walk, because its stationarity assumption fails there."
        },
        {
          "id": "H6",
          "statement": "Long memory costs power, not size: with the circular-shift null, the lag-2 edge at coupling 0.3 is recovered less often at the largest H than at H = 0.5."
        }
      ]
    },
